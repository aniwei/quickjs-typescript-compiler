		},
		{
			"label": "Decode optional-chaining pc2line (outer+inner)",
			"type": "shell",
			"command": "pnpm -s exec tsx -e 'import { parseBytecodeModule } from \"./src/bytecodeReader\"; import fs from \"fs\";\nconst PC2LINE_BASE=-1, PC2LINE_RANGE=5, PC2LINE_OP_FIRST=1;\nfunction readULEB(data:Uint8Array, st:{i:number}){let r=0,sh=0; while(st.i<data.length){const b=data[st.i++]; r|=(b&0x7f)<<sh; if((b&0x80)===0) break; sh+=7;} return r>>>0;}\nfunction readSLEB(data:Uint8Array, st:{i:number}){let r=0,sh=0,b=0; do{b=data[st.i++]; r|=(b&0x7f)<<sh; sh+=7;}while((b&0x80)!==0); if(sh<32 && (b&0x40)!==0){r|=(~0<<sh);} return r|0;}\nfunction decode(pc2:Uint8Array){const st={i:0}; const initLine=readULEB(pc2,st); const initCol=readULEB(pc2,st); let pc=0,line=initLine,col=initCol; const out:any[]=[{pc,line,col,kind:\"init\"}]; while(st.i<pc2.length){const op=pc2[st.i++]; if(op===0){ if(st.i>=pc2.length){out.push({kind:\"end\"}); break;} const dpc=readULEB(pc2,st); const dl=readSLEB(pc2,st); const dc=readSLEB(pc2,st); pc+=dpc; line+=dl; col+=dc; out.push({pc,line,col,op:\"long\",dpc,dl,dc}); } else { const opVal=op-PC2LINE_OP_FIRST; const dpc=Math.floor(opVal/PC2LINE_RANGE); const dl=(opVal%PC2LINE_RANGE)+PC2LINE_BASE; const dc=readSLEB(pc2,st); pc+=dpc; line+=dl; col+=dc; out.push({pc,line,col,op:\"short\",dpc,dl,dc,raw:op}); } } return out;}\nfunction inner(mod:any){const cp=mod.func.cpool||[]; return cp.find((e:any)=>e && typeof e===\"object\" && e.tag===12);\n}\nfunction show(name:string, pc2:Uint8Array){console.log(`\\n=== ${name} len=${pc2.length} ===`); console.log(Array.from(pc2).map(b=>b.toString(16).padStart(2,\"0\")).join(\" \")); console.log(decode(pc2));}\nconst ts=parseBytecodeModule(fs.readFileSync(\"artifacts/optional-chaining.ts.qbc\"));\nconst wasm=parseBytecodeModule(fs.readFileSync(\"artifacts/optional-chaining.wasm.qbc\"));\nshow(\"TS outer\", ts.func.debug!.pc2line);\nshow(\"WASM outer\", wasm.func.debug!.pc2line);\nshow(\"TS inner\", inner(ts).debug.pc2line);\nshow(\"WASM inner\", inner(wasm).debug.pc2line);\n'",
			"isBackground": false,
			"group": "build"
		}
