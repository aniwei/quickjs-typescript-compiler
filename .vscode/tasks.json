			"type": "shell",
			"command": "pnpm -s exec tsx -e 'import { parseBytecodeModule } from \"./src/bytecodeReader\"; import fs from \"fs\"; const ts=parseBytecodeModule(fs.readFileSync(\"artifacts/optional-chaining.ts.qbc\")); const wasm=parseBytecodeModule(fs.readFileSync(\"artifacts/optional-chaining.wasm.qbc\")); const tsDbg=ts.func.debug; const wasmDbg=wasm.func.debug; console.log(\"TS atoms\",ts.atoms.length,\"WASM atoms\",wasm.atoms.length); console.log(\"TS bytecodeLen\",ts.func.bytecodeLen,\"WASM\",wasm.func.bytecodeLen); console.log(\"TS cpoolCount\",ts.func.cpoolCount,\"WASM\",wasm.func.cpoolCount); console.log(\"TS hasDebug\",ts.func.hasDebug,\"WASM\",wasm.func.hasDebug); console.log(\"TS pc2lineLen\",tsDbg?.pc2line?.length||0,\"WASM\",wasmDbg?.pc2line?.length||0); console.log(\"TS sourceLen\",tsDbg?.source?.length||0,\"WASM\",wasmDbg?.source?.length||0);'",
